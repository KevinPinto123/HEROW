# Copia este archivo como frontend/.env.local
# Todo lo que empieza con VITE_ termina dentro del navegador:
# aquí SOLO van valores públicos. Nunca claves sk_, sb_secret_ ni de Gemini/OpenAI.

# Portal: clave publicable (pk_...)
VITE_PORTAL_PUBLISHABLE_KEY=

# Supabase: URL del proyecto y clave publishable (sb_publishable_...) o anon
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# URL del backend. Vacío = usa el proxy de Vite (/api -> localhost:3001).
VITE_API_URL=
