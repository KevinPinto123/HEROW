# Copia este archivo como frontend/.env.local
# Todo lo que empieza con VITE_ termina dentro del navegador:
# aquí SOLO van valores públicos. Nunca claves sk_, sb_secret_ ni de Gemini/OpenAI.

# Modo en vivo (multijugador): usa el WebSocket del propio backend (VITE_API_URL).
# No necesita claves. Pon false solo si quieres apagarlo.
VITE_LIVE_ENABLED=true

# Supabase: URL del proyecto y clave publishable (sb_publishable_...) o anon
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# URL del backend. Vacío = usa el proxy de Vite (/api -> localhost:3001).
VITE_API_URL=

# Microsoft Clarity (KPIs: mapas de calor, grabaciones y eventos). ID del proyecto en clarity.microsoft.com.
# Vacío = no se mide nada. Solo se activa si la persona acepta el aviso de medición.
VITE_CLARITY_ID=
