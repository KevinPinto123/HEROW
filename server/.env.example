# Copia este archivo como server/.env y llena los valores.
# server/.env NO se sube a git.

# ── Servidor ─────────────────────────────────────────────
PORT=3001
# Origen del frontend (CORS). En producción, la URL real del sitio.
CORS_ORIGIN=http://localhost:5173
# URL pública de ESTE backend. Portal la usa para leer /.well-known/jwks.json,
# así que en local necesitas un túnel (ngrok, cloudflared) o el backend desplegado.
PUBLIC_URL=http://localhost:3001

# ── IA: YessenIA ─────────────────────────────────────────
# Proveedor principal del chat: gemini | openai
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Moderación (siempre OpenAI; es gratuita). Obligatoria: las usuarias son menores.
OPENAI_MODERATION_MODEL=omni-moderation-latest

# ── Portal (multijugador en vivo) ────────────────────────
# La clave privada de firma la genera: npm run portal:keys
# (la escribe sola en server/.env). La pública se sirve en PUBLIC_URL/.well-known/jwks.json
# y en el dashboard de Portal se configura issuer = PUBLIC_URL.
PORTAL_JWT_KID=herow-1
PORTAL_JWT_PRIVATE_KEY=

# ── Scraping de recomendaciones ─────────────────────────
# Horas que se guardan en caché los resultados antes de volver a consultar.
SCRAPE_CACHE_HOURS=12

# ── Supabase (cuentas y progreso) ───────────────────────
SUPABASE_URL=
# Publishable (sb_publishable_...) — también va en el frontend.
SUPABASE_PUBLISHABLE_KEY=
# Secret (sb_secret_...) — SOLO servidor, salta las reglas RLS.
SUPABASE_SECRET_KEY=

# ── Portal: clave secreta (sk_...) — SOLO servidor ──────
PORTAL_SECRET_KEY=

# Atajos de prueba (botón "+50 demo" en el combate). NUNCA en producción.
DEV_TOOLS=false

# Contraseña de las cuentas de demo (npm run demo:seed)
DEMO_PASSWORD=
