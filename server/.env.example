# Copia este archivo como server/.env y llena los valores.
# server/.env NO se sube a git.

# ── Servidor ─────────────────────────────────────────────
PORT=3001
# Origen del frontend (CORS). En producción, la URL real del sitio.
CORS_ORIGIN=http://localhost:5173
# URL pública de ESTE backend.
PUBLIC_URL=http://localhost:3001

# ── IA: YessenIA ─────────────────────────────────────────
# Proveedor principal del chat: gemini | openai
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Moderación (siempre OpenAI; es gratuita). Obligatoria: las usuarias son menores.
OPENAI_MODERATION_MODEL=omni-moderation-latest

# ── Multijugador en vivo (HEROW Live) ────────────────────
# No necesita claves ni servicios externos: es un WebSocket en este mismo backend
# (ruta /live/ws). Se activa solo cuando Supabase está configurado.
# Los navegadores solo pueden conectarse desde los orígenes de CORS_ORIGIN.

# ── Scraping de recomendaciones ─────────────────────────
# Horas que se guardan en caché los resultados antes de volver a consultar.
SCRAPE_CACHE_HOURS=12

# ── Supabase (cuentas y progreso) ───────────────────────
SUPABASE_URL=
# Publishable (sb_publishable_...) — también va en el frontend.
SUPABASE_PUBLISHABLE_KEY=
# Secret (sb_secret_...) — SOLO servidor, salta las reglas RLS.
SUPABASE_SECRET_KEY=

# Atajos de prueba (botón "+50 demo" en el combate). NUNCA en producción.
DEV_TOOLS=false

# Contraseña de las cuentas de demo (npm run demo:seed)
DEMO_PASSWORD=

# ── Waitlist / leads (feria) ─────────────────────────────
# Token propio para descargar los contactos en CSV:
#   GET PUBLIC_URL/api/leads/export?token=EL_TOKEN
# Déjalo vacío y esa ruta queda apagada. Inventa algo largo, no lo compartas.
LEADS_ADMIN_TOKEN=

# ── Panel del equipo: red de mentoras (/mentoras/admin) ──
# Token para aprobar mentoras, eventos y respuestas. Vacío = usa LEADS_ADMIN_TOKEN.
# Si ninguno está configurado, el panel queda apagado.
ADMIN_TOKEN=
